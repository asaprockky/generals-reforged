diff --git a/Core/GameEngineDevice/Source/W3DDevice/GameClient/W3DView.cpp b/Core/GameEngineDevice/Source/W3DDevice/GameClient/W3DView.cpp
index 95183f37b..c319a243d 100644
--- a/Core/GameEngineDevice/Source/W3DDevice/GameClient/W3DView.cpp
+++ b/Core/GameEngineDevice/Source/W3DDevice/GameClient/W3DView.cpp
@@ -221,6 +221,24 @@ void W3DView::setHeight(Int height)
 	m_lastScreenToTerrainValid = false;
 }
 
+//-------------------------------------------------------------------------------------------------
+// Reforged @feature Hor+ widescreen. The horizontal FOV was fixed for every display shape, so a
+// display wider than 4:3 cropped the top and bottom of the view. Convert the 4:3 horizontal FOV
+// so that wider displays keep the 4:3 vertical FOV and see more to the sides instead. Displays
+// that are 4:3 or narrower are unchanged. The widening is capped at 16:9; wider displays crop
+// vertically beyond that, because the terrain draw area was only verified for up to 16:9.
+//-------------------------------------------------------------------------------------------------
+static Real getWidescreenHorizontalFov(Real horizontalFov4x3)
+{
+	const Real referenceWidth = (Real)TheDisplay->getHeight() * 4.0f / 3.0f;
+	const Real widthRatio = std::min((Real)TheDisplay->getWidth() / referenceWidth, (16.0f / 9.0f) / (4.0f / 3.0f));
+
+	if (widthRatio <= 1.0f)
+		return horizontalFov4x3;
+
+	return 2.0f * atan(tan(horizontalFov4x3 * 0.5f) * widthRatio);
+}
+
 //-------------------------------------------------------------------------------------------------
 /** Sets the width of the viewport, while maintaining original camera perspective. */
 //-------------------------------------------------------------------------------------------------
@@ -237,7 +255,7 @@ void W3DView::setWidth(Int width)
 
 	//we want to maintain the same scale, so we'll need to adjust the fov.
 	//default W3D fov for full-screen is 50 degrees.
-	m_3DCamera->Set_View_Plane((Real)width/(Real)TheDisplay->getWidth()*DEG_TO_RADF(50.0f),-1);
+	m_3DCamera->Set_View_Plane((Real)width/(Real)TheDisplay->getWidth()*getWidescreenHorizontalFov(DEG_TO_RADF(50.0f)),-1);
 
 	m_cameraAreaConstraintsValid = false;
 	m_recalcCamera = true;
@@ -832,7 +850,7 @@ void W3DView::setCameraTransform(const Matrix3D &transform)
 	m_lastScreenToTerrainValid = false;
 
 #if defined(RTS_DEBUG)
-	m_3DCamera->Set_View_Plane( m_FOV, -1 );
+	m_3DCamera->Set_View_Plane( getWidescreenHorizontalFov(m_FOV), -1 );
 #endif
 
 	m_3DCamera->Set_Transform(transform);
