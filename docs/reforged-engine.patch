+//-------------------------------------------------------------------------------------------------
+// Reforged @feature Move a group of ground units abreast, instead of in the original 2 lane
+// (vehicles) or 3 lane (infantry) column that strings out into single file. The units form a
+// block facing the move direction, up to 5 (vehicles) or 6 (infantry) lanes wide, and each one
+// follows the group path at its own lateral offset. Where the ground is too narrow for a lane, the
+// unit pulls in towards the centre line. Units keep the pace of the slowest unit of their kind (see
+// AIFollowPathState::onEnter), so the block stays together. Returns false to fall back to the
+// original movement.
+//-------------------------------------------------------------------------------------------------
+namespace
+{
+	struct AbreastUnit
+	{
+		Object *obj;
+		Real forward;		///< distance ahead of the group centre along the move direction
+		Real lateral;		///< distance left of the group centre
+		Real laneOffset;	///< assigned lane, as distance left of the path
+		Int row;			///< assigned row, 0 at the front
+	};
+}
+
+Bool AIGroup::friend_moveAbreastToPos( const Coord3D *pos, CommandSourceType cmdSource, Bool infantry )
+{
+	if (m_groundPath == nullptr)
+		return false;
+
+	Coord3D center;
+	if (!getCenter( &center ))
+		return false;
+
+	// Waypoints of the group path after its start (the group centre).
+	const Coord3D startPoint = *m_groundPath->getFirstNode()->getPosition();
+	std::vector<Coord3D> waypoints;
+	for (PathNode *node = m_groundPath->getFirstNode()->getNextOptimized(); node; node = node->getNextOptimized())
+		waypoints.push_back(*node->getPosition());
+	if (waypoints.empty())
+		return false;
+
+	Coord2D forwardDir;
+	forwardDir.x = waypoints.front().x - startPoint.x;
+	forwardDir.y = waypoints.front().y - startPoint.y;
+	if (forwardDir.length() < 1.0f)
+		return false;
+	forwardDir.normalize();
+
+	std::vector<AbreastUnit> units;
+	Real maxRadius = 0.0f;
+	Real slowestSpeed = FAST_AS_POSSIBLE;
+	PlayerType controllingPlayerType = PLAYER_COMPUTER;
+	for (std::list<Object *>::iterator i = m_memberList.begin(); i != m_memberList.end(); ++i)
+	{
+		Object *obj = *i;
+		if (obj->isDisabledByType( DISABLED_HELD ))
+			continue;
+		AIUpdateInterface *ai = obj->getAIUpdateInterface();
+		if (ai == nullptr)
+			continue;
+		if (infantry)
+		{
+			if (!obj->isKindOf( KINDOF_INFANTRY ))
+				continue;
+			if (obj->isKindOf( KINDOF_MOB_NEXUS ))
+				return false; // the mob nexus needs its far-away goal, as in friend_moveInfantryToPos
+		}
+		else
+		{
+			// Cliff jumpers get individual orders in groupMoveToPosition, as with the column move.
+			if (!obj->isKindOf( KINDOF_VEHICLE ) || !ai->isDoingGroundMovement() || obj->isKindOf( KINDOF_CLIFF_JUMPER ))
+				continue;
+		}
+		if (obj->getControllingPlayer())
+			controllingPlayerType = obj->getControllingPlayer()->getPlayerType();
+
+		const Real speed = ai->getCurLocomotorSpeed();
+		if (speed < slowestSpeed && IS_CONDITION_BETTER( obj->getBodyModule()->getDamageState(), TheGlobalData->m_movementPenaltyDamageState ))
+			slowestSpeed = speed;
+		maxRadius = std::max(maxRadius, obj->getGeometryInfo().getMajorRadius());
+
+		// Units that move at the back of a group (artillery etc.) are sorted behind the others.
+		Real priorityAdjust = 0.0f;
+		if (ai->getCurLocomotor())
+		{
+			const LocomotorPriority movePriority = ai->getCurLocomotor()->getMovePriority();
+			if (movePriority == LOCO_MOVES_MIDDLE)
+				priorityAdjust = -100*PATHFIND_CELL_SIZE_F;
+			else if (movePriority == LOCO_MOVES_BACK)
+				priorityAdjust = -200*PATHFIND_CELL_SIZE_F;
+		}
+
+		const Real dx = obj->getPosition()->x - center.x;
+		const Real dy = obj->getPosition()->y - center.y;
+		AbreastUnit unit;
+		unit.obj = obj;
+		unit.forward = dx*forwardDir.x + dy*forwardDir.y + priorityAdjust;
+		unit.lateral = -dx*forwardDir.y + dy*forwardDir.x;
+		unit.laneOffset = 0.0f;
+		unit.row = 0;
+		units.push_back(unit);
+	}
+
+	const Int minUnits = infantry ? TheAI->getAiData()->m_minInfantryForGroup : TheAI->getAiData()->m_minVehiclesForGroup;
+	if ((Int)units.size() < minUnits)
+		return false;
+
+	// Lay out the block: the front-most units form the front row, and each row keeps the units'
+	// current left-to-right order so paths don't cross. A partial last row is centred.
+	const Int maxLanes = infantry ? 6 : 5;
+	const Real minSpacing = (infantry ? 1.5f : 2.5f) * PATHFIND_CELL_SIZE_F;
+	const Real spacing = std::max(minSpacing, 2.0f*maxRadius + 0.5f*PATHFIND_CELL_SIZE_F);
+	const Int lanes = std::min((Int)units.size(), maxLanes);
+
+	std::sort(units.begin(), units.end(), [](const AbreastUnit &a, const AbreastUnit &b) {
+		if (a.forward != b.forward)
+			return a.forward > b.forward;
+		return a.obj->getID() < b.obj->getID();
+	});
+	for (size_t rowStart = 0; rowStart < units.size(); rowStart += lanes)
+	{
+		const size_t rowEnd = std::min(rowStart + (size_t)lanes, units.size());
+		std::sort(units.begin() + rowStart, units.begin() + rowEnd, [](const AbreastUnit &a, const AbreastUnit &b) {
+			if (a.lateral != b.lateral)
+				return a.lateral < b.lateral;
+			return a.obj->getID() < b.obj->getID();
+		});
+		const Real rowCenter = 0.5f * (Real)(rowEnd - rowStart - 1);
+		for (size_t k = rowStart; k < rowEnd; ++k)
+		{
+			units[k].laneOffset = ((Real)(k - rowStart) - rowCenter) * spacing;
+			units[k].row = (Int)rowStart / lanes;
+		}
+	}
+
+	// The block ends with its front row on the destination, facing the final path direction.
+	const Coord3D endPoint = *m_groundPath->getLastNode()->getPosition();
+	const Coord3D beforeEnd = waypoints.size() >= 2 ? waypoints[waypoints.size()-2] : startPoint;
+	Coord2D endDir;
+	endDir.x = endPoint.x - beforeEnd.x;
+	endDir.y = endPoint.y - beforeEnd.y;
+	if (endDir.length() < 1.0f)
+		endDir = forwardDir;
+	else
+		endDir.normalize();
+	const PathfindLayerEnum layer = TheTerrainLogic->getLayerForDestination(pos);
+
+	for (std::vector<AbreastUnit>::iterator it = units.begin(); it != units.end(); ++it)
+	{
+		Object *theUnit = it->obj;
+		AIUpdateInterface *ai = theUnit->getAIUpdateInterface();
+		const LocomotorSurfaceTypeMask surfaces = ai->getLocomotorSet().getValidSurfaces();
+		TheAI->pathfinder()->removeGoal(theUnit);
+
+		std::vector<Coord3D> path;
+		Coord3D prevPos = *theUnit->getPosition();
+		for (size_t w = 0; w + 1 < waypoints.size(); ++w)
+		{
+			const Coord3D &before = (w == 0) ? startPoint : waypoints[w-1];
+			const Coord3D &after = waypoints[w+1];
+			Coord2D dir;
+			dir.x = after.x - before.x;
+			dir.y = after.y - before.y;
+			if (dir.length() < 1.0f)
+				continue;
+			dir.normalize();
+
+			// Use the full lane offset where possible, otherwise pull in towards the centre line.
+			const Real offsets[3] = { it->laneOffset, 0.5f*it->laneOffset, 0.0f };
+			Coord3D dest = waypoints[w];
+			for (Int o = 0; o < 3; ++o)
+			{
+				dest = waypoints[w];
+				dest.x += -dir.y * offsets[o];
+				dest.y += dir.x * offsets[o];
+				if (o == 2 || TheAI->pathfinder()->isLinePassable(theUnit, surfaces, theUnit->getLayer(), prevPos, dest, false, true))
+					break;
+			}
+			clampToMap(&dest, controllingPlayerType);
+
+			// Skip waypoints that would send the unit backwards.
+			if ((dest.x - prevPos.x)*dir.x + (dest.y - prevPos.y)*dir.y > 0.0f)
+			{
+				path.push_back(dest);
+				prevPos = dest;
+			}
+		}
+
+		Coord3D dest = *pos;
+		dest.x += -endDir.y * it->laneOffset - endDir.x * it->row * spacing;
+		dest.y += endDir.x * it->laneOffset - endDir.y * it->row * spacing;
+		dest.z = TheTerrainLogic->getLayerHeight( dest.x, dest.y, layer );
+
+		// Drop waypoints at or beyond the final slot so the unit doesn't overshoot and turn back.
+		while (!path.empty())
+		{
+			const Coord3D &last = path.back();
+			if ((dest.x - last.x)*endDir.x + (dest.y - last.y)*endDir.y <= 0.0f)
+				path.pop_back();
+			else
+				break;
+		}
+
+		clampToMap(&dest, controllingPlayerType);
+		TheAI->pathfinder()->adjustDestination(theUnit, ai->getLocomotorSet(), &dest, nullptr);
+		TheAI->pathfinder()->updateGoal(theUnit, &dest, LAYER_GROUND);
+		path.push_back(dest);
+		ai->aiFollowPath( &path, nullptr, cmdSource );
+	}
+
+	if (infantry)
+		m_abreastSpeedInfantry = slowestSpeed;
+	else
+		m_abreastSpeedVehicle = slowestSpeed;
+	return true;
+}
