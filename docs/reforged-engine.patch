+//-------------------------------------------------------------------------------------------------
+// Reforged @feature Developer quick start (-skirmishTest <PlayerTemplate> [<AIPlayerTemplate>]): a skirmish
+// against one easy AI on the player's last skirmish map, set up like the skirmish menu does it.
+//-------------------------------------------------------------------------------------------------
+static Int findPlayerTemplateIndex( const AsciiString& name )
+{
+	for (Int i = 0; i < ThePlayerTemplateStore->getPlayerTemplateCount(); ++i)
+	{
+		const PlayerTemplate *pt = ThePlayerTemplateStore->getNthPlayerTemplate(i);
+		if (pt && pt->getName().compareNoCase(name) == 0)
+			return i;
+	}
+	return PLAYERTEMPLATE_RANDOM;
+}
+
+void StartTestSkirmish()
+{
+	const AsciiString faction = TheGlobalData->m_testSkirmishFaction;
+	const AsciiString aiFaction = TheGlobalData->m_testSkirmishAIFaction;
+	const AsciiString map = TheGlobalData->m_testSkirmishMap;
+	TheWritableGlobalData->m_testSkirmishFaction.clear();
+	TheWritableGlobalData->m_testSkirmishAIFaction.clear();
+	TheWritableGlobalData->m_testSkirmishMap.clear();
+
+	if (TheGameLogic->isInGame())
+		TheGameLogic->clearGameData(FALSE);
+
+	if (TheSkirmishGameInfo == nullptr)
+		TheSkirmishGameInfo = NEW SkirmishGameInfo;
+	TheSkirmishGameInfo->init();
+	TheSkirmishGameInfo->clearSlotList();
+	TheSkirmishGameInfo->reset();
+	TheSkirmishGameInfo->setLocalIP(TheSkirmishGameInfo->getSlot(0)->getIP());
+	TheSkirmishGameInfo->enterGame();
+
+	SkirmishPreferences prefs;
+	GameSlot player;
+	player.setName(prefs.getUserName());
+	player.setState(SLOT_PLAYER, prefs.getUserName());
+	player.setColor(prefs.getPreferredColor());
+	player.setPlayerTemplate(findPlayerTemplateIndex(faction));
+	TheSkirmishGameInfo->setSlot(0, player);
+
+	GameSlot ai;
+	ai.setState(SLOT_EASY_AI);
+	ai.setPlayerTemplate(aiFaction.isEmpty() ? PLAYERTEMPLATE_RANDOM : findPlayerTemplateIndex(aiFaction));
+	TheSkirmishGameInfo->setSlot(1, ai);
+
+	TheSkirmishGameInfo->setSeed(GetTickCount());
+	TheSkirmishGameInfo->setStartingCash(prefs.getStartingCash());
+	TheSkirmishGameInfo->setSuperweaponRestriction(prefs.getSuperweaponRestricted() ? 1 : 0);
+	TheSkirmishGameInfo->setMap(map.isEmpty() ? prefs.getPreferredMap() : map);
+	const MapMetaData *md = TheMapCache->findMap(TheSkirmishGameInfo->getMap());
+	TheSkirmishGameInfo->setMapCRC(md ? md->m_CRC : 0);
+	TheSkirmishGameInfo->setMapSize(md ? md->m_filesize : 0);
+
+	TheWritableGlobalData->m_mapName = TheSkirmishGameInfo->getMap();
+	TheWritableGlobalData->m_testSkirmishSelectDozer = TRUE;
+	TheSkirmishGameInfo->startGame(0);
+	InitRandom(TheSkirmishGameInfo->getSeed());
+
+	GameMessage *msg = TheMessageStream->appendMessage( GameMessage::MSG_NEW_GAME );
+	msg->appendIntegerArgument(GAME_SKIRMISH);
+	msg->appendIntegerArgument(DIFFICULTY_NORMAL);
+	msg->appendIntegerArgument(0);
+	msg->appendIntegerArgument(TheGlobalData->m_framesPerSecondLimit);
+}
