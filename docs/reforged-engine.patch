+// Reforged: the scheme for a side with the largest creation resolution, or nullptr
+ControlBarScheme *ControlBarSchemeManager::findBestControlBarSchemeForSide( const AsciiString& side )
+{
+	ControlBarScheme *best = nullptr;
+	if(side.isEmpty())
+		return nullptr;
+	for (ControlBarSchemeList::iterator it = m_schemeList.begin(); it != m_schemeList.end(); ++it)
+	{
+		ControlBarScheme *CBScheme = *it;
+		if(CBScheme && CBScheme->m_side.compareNoCase( side ) == 0
+			&& (!best || best->m_ScreenCreationRes.x < CBScheme->m_ScreenCreationRes.x))
+			best = CBScheme;
+	}
+	return best;
+}
