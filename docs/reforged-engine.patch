diff --git a/Core/GameEngine/Source/Common/FramePacer.cpp b/Core/GameEngine/Source/Common/FramePacer.cpp
index 992cd45c7..6b33e55e7 100644
--- a/Core/GameEngine/Source/Common/FramePacer.cpp
+++ b/Core/GameEngine/Source/Common/FramePacer.cpp
@@ -93,6 +93,30 @@ Int FramePacer::getFramesPerSecondLimit()  const
 	return m_maxFPS;
 }
 
+//-------------------------------------------------------------------------------------------------
+// Reforged @feature Smooth rendering. Originally the fps limit was also the game speed, because the
+// game logic advanced once per rendered frame. Now the game speed drives the logic time scale, and
+// the render limit follows the display refresh rate. The engine interpolates drawn movement and
+// animation between logic frames, so the picture is smooth while the game runs at its normal speed.
+// Ctrl+Numpad +/- still change the render limit. Network games keep their own logic rate.
+//-------------------------------------------------------------------------------------------------
+void FramePacer::setGameSpeedFps( Int fps )
+{
+	setLogicTimeScaleFps(fps);
+	enableLogicTimeScale(TRUE);
+	setFramesPerSecondLimit(std::max(fps, getDisplayRefreshRate()));
+}
+
+Int FramePacer::getDisplayRefreshRate()
+{
+	DEVMODE mode;
+	memset(&mode, 0, sizeof(mode));
+	mode.dmSize = sizeof(mode);
+	if (EnumDisplaySettings(nullptr, ENUM_CURRENT_SETTINGS, &mode) && mode.dmDisplayFrequency > 1)
+		return clamp<Int>(30, (Int)mode.dmDisplayFrequency, 360);
+	return 60;
+}
+
 void FramePacer::enableFramesPerSecondLimit( Bool enable )
 {
 	m_enableFpsLimit = enable;
