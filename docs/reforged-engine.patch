+//-------------------------------------------------------------------------------------------------
+// Reforged @feature Formations (Ctrl+F) turn to face the direction they move in. Formation offsets
+// are stored relative to the formation's facing when it was created: x is forward, y is left.
+//-------------------------------------------------------------------------------------------------
+static Coord2D formationOffsetToWorld( const Coord2D &local, const Coord2D &facing )
+{
+	Coord2D world;
+	world.x = local.x * facing.x - local.y * facing.y;
+	world.y = local.x * facing.y + local.y * facing.x;
+	return world;
+}
+
+/// Average facing of the members, or +x if they face every way.
+static Coord2D getMembersFacing( const std::list<Object *> &members )
+{
+	Coord2D facing;
+	facing.x = 0.0f;
+	facing.y = 0.0f;
+	for (std::list<Object *>::const_iterator i = members.begin(); i != members.end(); ++i)
+	{
+		const Real angle = (*i)->getOrientation();
+		facing.x += Cos( angle );
+		facing.y += Sin( angle );
+	}
+	if (facing.length() < 0.01f)
+	{
+		facing.x = 1.0f;
+		facing.y = 0.0f;
+	}
+	else
+	{
+		facing.normalize();
+	}
+	return facing;
+}
+
+/// Direction of a move, or the members' facing for a very short move.
+static Coord2D getMoveFacing( const Coord3D &from, const Coord3D &to, const std::list<Object *> &members )
+{
+	Coord2D facing;
+	facing.x = to.x - from.x;
+	facing.y = to.y - from.y;
+	if (facing.length() < PATHFIND_CELL_SIZE_F)
+		return getMembersFacing( members );
+	facing.normalize();
+	return facing;
+}
