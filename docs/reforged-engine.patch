+//-------------------------------------------------------------------------------------------------
+// Reforged @feature Hor+ widescreen. The horizontal FOV was fixed for every display shape, so a
+// display wider than 4:3 cropped the top and bottom of the view. Convert the 4:3 horizontal FOV
+// so that wider displays keep the 4:3 vertical FOV and see more to the sides instead. Displays
+// that are 4:3 or narrower are unchanged. The widening is capped at 16:9; wider displays crop
+// vertically beyond that, because the terrain draw area was only verified for up to 16:9.
+//-------------------------------------------------------------------------------------------------
+static Real getWidescreenHorizontalFov(Real horizontalFov4x3)
+{
+	const Real referenceWidth = (Real)TheDisplay->getHeight() * 4.0f / 3.0f;
+	const Real widthRatio = std::min((Real)TheDisplay->getWidth() / referenceWidth, (16.0f / 9.0f) / (4.0f / 3.0f));
+
+	if (widthRatio <= 1.0f)
+		return horizontalFov4x3;
+
+	return 2.0f * atan(tan(horizontalFov4x3 * 0.5f) * widthRatio);
+}
+
